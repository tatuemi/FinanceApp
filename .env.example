# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a `.env.local` para desarrollo local.
# NUNCA subas `.env` ni `.env.local` a Git ni expongas secretos en el cliente.
# ==============================================================================

# 1. Supabase (PostgreSQL + Autenticación Google OAuth 2.0)
# Encuéntralos en: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable-publica
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-clave-anon-o-publishable-publica

# 2. Credenciales Google OAuth 2.0
# Nota: En Supabase Auth, el Client ID y Client Secret de Google se configuran
# en: Supabase Dashboard -> Authentication -> Providers -> Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 3. Proveedor de Datos Bursátiles (Exclusivo del servidor - NUNCA usar prefijo NEXT_PUBLIC_)
# Opciones soportadas: "twelvedata" | "finnhub" | "manual"
# Si no se configura clave o se elige "manual", la aplicación opera en modo de cotizaciones manuales ($0 USD).
MARKET_DATA_PROVIDER=twelvedata
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=

# 4. URL pública de la aplicación (usada para callbacks OAuth y metadatos PWA)
NEXT_PUBLIC_APP_URL=http://localhost:3000
